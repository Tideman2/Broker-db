        <mxCell id="qUDhlh0_Rq3lrwbxW-Kf-1" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;The Portfolio Domain manages a user&#39;s investments.&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;br&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;It is responsible for recording buy and sell transactions,&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;calculating current holdings, portfolio value,&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;asset allocation, profit/loss, and other&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;investment-related metrics.&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;br&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Core entities:&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;- Transaction&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;- Instrument&lt;/h1&gt;&lt;div&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;- Categories&lt;/h1&gt;&lt;/div&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;br&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Derived concepts:&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;- Holdings&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;- Portfolio Value&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;- Asset Allocation&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;- Profit/Loss&lt;/h1&gt;&lt;div&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;- Risk Appetite&lt;/h1&gt;&lt;/div&gt;&lt;div&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;- Diversification Score&lt;/h1&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="840" y="113" width="520" height="929" as="geometry" />
        </mxCell>
        <mxCell id="71AOpyUVyoKA3y2kOCjj-1" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;font-size: 22px;&quot;&gt;&lt;u&gt;Algorithms For Derived Concepts&lt;/u&gt;&lt;/span&gt;&lt;/h1&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;Data-base layer will do it&#39;s job of joining the transaction Table with the instrument&amp;nbsp;&lt;/font&gt;&lt;/font&gt;&lt;span style=&quot;font-size: 19px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Table and then filter them using the user_id. API level takes over and calculate needed info&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;from it.&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;Holdings&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;---------&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;Net Quantity =&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;SUM(BUY Quantity) - SUM(SELL Quantity)&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;&lt;br&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;Instrument Value =&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;Net Quantity × Current Price&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;&lt;br&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;&lt;br&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;Portfolio Value&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;---------------&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;Portfolio Value =&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;SUM(All Instrument Values)&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;&lt;br&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;&lt;br&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;Asset Allocation&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;----------------&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;Allocation % =&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;(Instrument Value / Portfolio Value) × 100&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;&lt;br&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;&lt;br&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;Diversification Score&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;---------------------&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;Largest Holding Percentage =&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;(Max Instrument Value / Portfolio Value) × 100&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;&lt;br&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;Largest Holding &amp;gt; 70%&amp;nbsp; &amp;nbsp; &amp;nbsp; → Poor&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;Largest Holding 40%–70%&amp;nbsp; &amp;nbsp; → Moderate&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;Largest Holding ≤ 40%&amp;nbsp; &amp;nbsp; &amp;nbsp; → Good&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;&lt;br&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;&lt;br&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;Portfolio Risk Level&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;--------------------&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;Category Weights&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;&lt;br&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;INDEX = 1&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;FOREX = 2&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;COMMODITY = 3&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;CRYPTO = 5&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;&lt;br&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;Risk Score =&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;Σ(Allocation % × Category Weight) / 100&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;&lt;br&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;1.0–2.0&amp;nbsp; &amp;nbsp; → Low&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;2.0–3.5&amp;nbsp; &amp;nbsp; → Moderate&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;3.5–5.0&amp;nbsp; &amp;nbsp; → High&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;&lt;br&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;&lt;br&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;Profit/Loss&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;-----------&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;Uses FIFO to determine the remaining buy lots.&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;1.Create a buy queue for buy lots in Chronological order, for every sell we calculate the realised profit for that sell.&lt;/h1&gt;&lt;div&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;ALGORITHM :&lt;/h1&gt;&lt;/div&gt;&lt;div&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;Replay transactions from oldest to newest.&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;&lt;br&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;If BUY:&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;&amp;nbsp; &amp;nbsp; Add the buy lot to the back of the queue.&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;&lt;br&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;If SELL:&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;&amp;nbsp; &amp;nbsp; While there is still quantity left to sell:&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; Look at the oldest buy lot.&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; Consume as much of that lot as possible.&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; Calculate realized profit for the consumed quantity.&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; Update or remove the buy lot.&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; Reduce the remaining sell quantity.&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;&lt;br&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;After every transaction has been processed:&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;&lt;br&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;The remaining buy queue represents the current holdings.&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;&lt;br&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;For each remaining buy lot:&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;&amp;nbsp; &amp;nbsp; Unrealized Profit +=&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; (Current Price - Buy Price)&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; × Remaining Quantity&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;&lt;br&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;Portfolio Realized Profit =&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;SUM(realized profits for all sells)&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;&lt;br&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;Portfolio Unrealized Profit =&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;SUM(unrealized profits for all remaining buy lots)&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;&lt;br&gt;&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;Portfolio Total Profit/Loss =&lt;/h1&gt;&lt;h1 data-end=&quot;214&quot; data-start=&quot;204&quot; data-section-id=&quot;1cimyl6&quot;&gt;Realized Profit + Unrealized Profit&lt;/h1&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="130" y="1260" width="1430" height="4020" as="geometry" />
        </mxCell>
        <mxCell id="YmqWEkNqxm_5pDAJmDWU-1" value="&lt;h2 data-end=&quot;1187&quot; data-start=&quot;1170&quot; data-section-id=&quot;qn09o2&quot;&gt;Get Holdings&lt;/h2&gt;&lt;h2 data-end=&quot;809&quot; data-start=&quot;791&quot; data-section-id=&quot;1e976jq&quot;&gt;&lt;p data-end=&quot;1195&quot; data-start=&quot;1189&quot;&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;Rules:&lt;/span&gt;&lt;/p&gt;&lt;pre data-end=&quot;1346&quot; data-start=&quot;1197&quot; class=&quot;overflow-visible! px-0!&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot; dir=&quot;ltr&quot; id=&quot;code-block-viewer&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code style=&quot;font-weight: normal;&quot;&gt;1. User must exist.&lt;br&gt;2. Transaction must exist for the user.&lt;/code&gt;&lt;/pre&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code style=&quot;font-weight: normal;&quot;&gt;&lt;pre style=&quot;font-weight: 700;&quot; class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code style=&quot;font-weight: normal;&quot;&gt;3. &lt;/code&gt;&lt;/pre&gt;&lt;br&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;/h2&gt;" style="whiteSpace=wrap;html=1;" parent="1" vertex="1">
