        <mxCell id="BMGN7j207yD2xt5cfLYS-1" value="&lt;font style=&quot;font-size: 26px;&quot;&gt;Business Actions &amp;amp; Rules for Wallet Domian&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=25;fontStyle=5" vertex="1" parent="1">
